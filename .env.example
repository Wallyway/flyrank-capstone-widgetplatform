# Copy to .env before running. Every value here is a safe placeholder.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=widgetuser
POSTGRES_PASSWORD=widgetpass
POSTGRES_DB=widgets
DATABASE_URL=postgresql://widgetuser:widgetpass@localhost:5432/widgets

# --- Public URLs ------------------------------------------------------------
# What the embed snippet points at. Change if you serve the API elsewhere.
PUBLIC_BASE_URL=http://localhost:8000

# --- Payload limits ---------------------------------------------------------
MAX_BODY_BYTES=8192
MAX_FIELD_LENGTH=2000

# --- Abuse protection -------------------------------------------------------
# Believe X-Forwarded-For. Only turn this on when a proxy you control sets it,
# otherwise anyone can walk past the per-IP limit with one header.
TRUST_PROXY_HEADERS=0
RATE_LIMIT_PER_IP=10
RATE_LIMIT_PER_IP_WINDOW=60
RATE_LIMIT_PER_WIDGET=25
RATE_LIMIT_PER_WIDGET_WINDOW=60
# The hidden field a person never sees. Anything in it means "not a person".
HONEYPOT_FIELD=website

# --- Geo enrichment ---------------------------------------------------------
# Chain order. Providers: ipapi (ip-api.com), ipapico (ipapi.co),
# mock_a / mock_b (deterministic, for proving the fallback).
GEO_PROVIDERS=ipapi,ipapico
GEO_TIMEOUT_SECONDS=2.0
# Flip either to 1 to simulate a dead upstream. This is how PROBE 4 is proven.
GEO_PROVIDER_A_DOWN=0
GEO_PROVIDER_B_DOWN=0
# Geo lookups are skipped for private IPs. Set this to test from localhost.
GEO_FORCE_CLIENT_IP=

# --- Safe side effects ------------------------------------------------------
# Left empty, the webhook step is skipped and only the "email" is logged.
WEBHOOK_URL=
# Set to 1 to make the notification throw every time. Used to prove that a
# broken side effect still leaves the submission stored and successful.
NOTIFY_FORCE_FAILURE=0
NOTIFY_TIMEOUT_SECONDS=5.0
NOTIFY_MAX_ATTEMPTS=4
NOTIFY_POLL_SECONDS=2.0
